# 首次启动会自动创建配置，也可通过「模型与服务设置」修改。
port = 0
concurrency = 4
text_connection = "ark"
vision_connection = "ark"
image_connection = "ark"
tts_connection = "speech"
openai_model = "deepseek-v4-1-flash-260910"
vision_model = "doubao-seed-2-1-lite-260915"
image_model = "doubao-seedream-5-0-flash-260915"
text_thinking = false
images_enabled = false
audio_enabled = false
# 默认使用豆包；macOS 可改为 system，使用系统语音生成 WAV，无需语音 Key。
audio_backend = "doubao"
# system 模式：留空使用系统默认音色，也可填写已安装的音色名称。
system_voice = ""
tts_model = "seed-tts-2.0"
tts_voice = "zh_female_vv_uranus_bigtts"

# 文本、识图、配图共用这份方舟 Key。
[[connections]]
id = "ark"
name = "火山方舟"
provider = "ark"
base_url = "https://ark.cn-beijing.volces.com/api/v3"
api_key = ""
# 可选的完整接口地址覆盖；留空时从 base_url 自动构造。
text_url = ""
image_url = ""
tts_url = ""
# 可添加账户中的模型，kind 支持 text、vision、image。
models = []

# 豆包语音使用独立的语音服务 Key。
[[connections]]
id = "speech"
name = "豆包语音"
provider = "doubao"
base_url = "https://openspeech.bytedance.com/api/v3/tts/unidirectional"
api_key = ""
text_url = ""
image_url = ""
tts_url = ""
# kind 为 audio。
models = []
